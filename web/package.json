{
  "name": "hope-kitchen-web",
  "version": "0.1.0",
  "private": true,
  "description": "Hope Kitchen on the web: Next.js + Supabase, built the way FQC is.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:lan": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:sql": "node tools/test-sql.mjs",
    "test": "npm run typecheck && npm run test:sql",
    "verify": "npm run test && npm run build",
    "dev:preview": "NEXT_PUBLIC_HK_PREVIEW=1 next dev -H 127.0.0.1 -p 3217",
    "local:db": "node tools/local-server.mjs",
    "dev:local": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=local-test-anon-key SUPABASE_SERVICE_ROLE_KEY=local-test-service-key next dev -H 127.0.0.1 -p 3218"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.112.3",
    "@zxing/browser": "0.2.1",
    "dexie": "4.4.5",
    "jsbarcode": "3.12.3",
    "next": "15.5.28",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
