# Copy to .env.local (never committed). Values come from the Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct database connection for applying migrations from this Mac (Settings > Database > Session pooler).
SUPABASE_DB_URL=
# Server only (never NEXT_PUBLIC_): makes manager and tablet sign-ins and redeems pairing codes (Settings > API > service_role).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the address domain for tablet sign-ins nobody reads (default tablets.hope-kitchen.invalid).
HK_TABLET_EMAIL_DOMAIN=
# Preview mode: every screen with invented data, no sign-in. Refused on Vercel.
NEXT_PUBLIC_HK_PREVIEW=
