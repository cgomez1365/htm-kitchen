# Copy to .env.local (never committed). Values come from the Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct database connection for applying migrations from this Mac (Settings > Database > Session pooler).
SUPABASE_DB_URL=
# Preview mode: every screen with invented data, no sign-in. Refused on Vercel.
NEXT_PUBLIC_HK_PREVIEW=
